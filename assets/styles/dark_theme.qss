/* HqFriend — Tema Dark Mode global (#121212 / #000000) */

QWidget {
    background-color: #121212;
    color: #e0e0e0;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QToolTip {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    padding: 4px;
}

/* ---- Botões ---- */
QPushButton {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton:hover { background-color: #333333; }
QPushButton:pressed { background-color: #1f1f1f; }
QPushButton:disabled { color: #616161; border-color: #2a2a2a; }

QPushButton#primaryButton {
    background-color: #e5a00d;
    color: #121212;
    border: none;
    font-weight: 600;
    padding: 8px 20px;
}
QPushButton#primaryButton:hover { background-color: #f0b232; }

/* ---- Cabeçalho da Tela Inicial ---- */
QLabel#appTitle { font-size: 18pt; font-weight: 700; color: #ffffff; }
QLabel#rootLabel, QLabel#scanStatus { color: #9e9e9e; }
QLabel#emptyStateText { color: #bdbdbd; font-size: 12pt; }

/* ---- Grid e cards de séries ---- */
QScrollArea { border: none; }

QFrame#seriesCard {
    background-color: #1e1e1e;
    border-radius: 8px;
}
QFrame#seriesCard:hover { background-color: #2a2a2a; }

QFrame#seriesCard QLabel { background: transparent; }

QFrame#seriesCard QLabel#coverLabel {
    background-color: #000000;
    color: #757575;
    border-radius: 4px;
}
QFrame#seriesCard QLabel#seriesTitle { font-weight: 600; color: #ffffff; }
QFrame#seriesCard QLabel#seriesCounter { color: #9e9e9e; }

QFrame#seriesCard QLabel#statusBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 8.5pt;
    font-weight: 600;
}
QFrame#seriesCard QLabel#statusBadge[status="UNREAD"] { background-color: #3a3a3a; color: #cfcfcf; }
QFrame#seriesCard QLabel#statusBadge[status="IN_PROGRESS"] { background-color: #8a5a00; color: #ffe2a8; }
QFrame#seriesCard QLabel#statusBadge[status="READ"] { background-color: #1f6b43; color: #c6f6d5; }

/* ---- Tela da Série (SeriesView) ---- */
QLabel#seriesViewTitle { font-size: 18pt; font-weight: 700; color: #ffffff; }
QLabel#seriesViewCounter { color: #9e9e9e; }
QLabel#seriesViewHint { color: #757575; padding-top: 6px; }

QWidget#seriesView QLabel#statusBadge {
    border-radius: 4px;
    padding: 3px 10px;
    font-weight: 600;
}
QWidget#seriesView QLabel#statusBadge[status="UNREAD"] { background-color: #3a3a3a; color: #cfcfcf; }
QWidget#seriesView QLabel#statusBadge[status="IN_PROGRESS"] { background-color: #8a5a00; color: #ffe2a8; }
QWidget#seriesView QLabel#statusBadge[status="READ"] { background-color: #1f6b43; color: #c6f6d5; }

QTreeWidget#comicList {
    background-color: #1a1a1a;
    alternate-background-color: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    outline: none;
}
QTreeWidget#comicList::item { padding: 8px 6px; border: none; }
QTreeWidget#comicList::item:hover { background-color: #2a2a2a; }
QTreeWidget#comicList::item:selected { background-color: #3a2c08; color: #ffffff; }
QHeaderView::section {
    background-color: #121212;
    color: #9e9e9e;
    border: none;
    border-bottom: 1px solid #2a2a2a;
    padding: 8px 6px;
    font-weight: 600;
}

/* ---- Leitor (ReaderView) ---- */
QGraphicsView#readerView { background-color: #000000; border: none; }
QLabel#pageIndicator {
    background-color: rgba(18, 18, 18, 200);
    color: #e0e0e0;
    border-radius: 10px;
    padding: 4px 12px;
    font-size: 9pt;
}

QLabel#readerToast {
    background-color: rgba(30, 30, 30, 230);
    color: #ffffff;
    border: 1px solid #e5a00d;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 10pt;
}

/* ---- Seletor de capa (CoverPickerDialog) ---- */
QLabel#stepTitle { font-size: 11pt; font-weight: 600; color: #ffffff; }
QLabel#pickerStatus { color: #9e9e9e; }

QComboBox {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 6px 10px;
}
QComboBox:hover { border-color: #e5a00d; }
QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    selection-background-color: #e5a00d;
    selection-color: #121212;
}

QListWidget#thumbnailGrid {
    background-color: #000000;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
}
QListWidget#thumbnailGrid::item {
    color: #9e9e9e;
    border: 2px solid transparent;
    border-radius: 4px;
    padding: 4px;
}
QListWidget#thumbnailGrid::item:hover { background-color: #1e1e1e; }
QListWidget#thumbnailGrid::item:selected {
    border-color: #e5a00d;
    background-color: #2a2a2a;
    color: #ffffff;
}

/* ---- Menus de contexto ---- */
QMenu {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    padding: 4px;
}
QMenu::item { padding: 6px 24px; border-radius: 4px; background: transparent; }
QMenu::item:selected { background-color: #e5a00d; color: #121212; }
QMenu::item:disabled { color: #616161; }
QMenu::separator { height: 1px; background: #3a3a3a; margin: 4px 8px; }

/* ---- Barras de rolagem ---- */
QScrollBar:vertical { background: #121212; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #3a3a3a; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #4a4a4a; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
